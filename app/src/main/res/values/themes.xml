<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tapasya" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/tapasya_primary</item>
        <item name="colorOnPrimary">@color/tapasya_on_primary</item>
        <item name="colorSecondary">@color/tapasya_secondary</item>
        <item name="android:colorAccent">@color/tapasya_primary</item>
        <item name="android:statusBarColor">@color/tapasya_background</item>
        <item name="android:navigationBarColor">@color/tapasya_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/tapasya_background</item>
        <item name="android:fontFamily">sans</item>
        <item name="materialButtonStyle">@style/Widget.Tapasya.Button</item>
    </style>

    <style name="Widget.Tapasya.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Tapasya.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
